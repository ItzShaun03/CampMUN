# CampMUN portal — environment variables
# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Collections are created automatically).
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?appName=CampMUN

# Deployed Apps Script /exec URL bound to your CampMUN Google Sheet.
# See GOOGLE-SHEETS-SETUP.md.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec

# Public local/deployed port.
PORT=3000

# Admin key for the upload/Manage APIs (x-admin-key header). Pick a long random string.
ADMIN_KEY=

# SMTP — required for confirmation emails. For Gmail use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="CampMUN Secretariat"

# Optional — only if you enable the AI chat assistant later.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
